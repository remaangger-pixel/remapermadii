{
  "version": 2,
  "rewrites": [
    { "source": "/api/dash-proxy", "destination": "/api/dash-proxy.js" },
    { "source": "/api/shortdrama", "destination": "/api/shortdrama.js" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" }
      ]
    }
  ]
}
